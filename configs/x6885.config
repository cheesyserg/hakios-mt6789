# HakiOS fragment: the Infinix Hot 60 Pro (x6885) -- what is true of this phone and of no other with an MT6789.
# Nothing here has run on the phone yet (docs/x6885-port.md): it is what the phone's own tree and Android's drivers for it say.
# The root on the UFS (redwood_ufs.c, ufs_root=1; mtkloader passes it, with ufs_lun= and ufs_dma=), the keypad and the
# PMIC's power key through the wrapper at 0x10026000 (buttons=3). The panel is a 1224 x 2720 AMOLED, video mode with DSC,
# shown at scale 3. Not here, and not to be added without a run that shows it: mtk_cpufreq (the Hot 20's PLL and PMIC
# rails), mali (the Mali-G57's power-up is not the G52's), touchscreen (a Goodix controller, not the TD4160).
CONFIG_DEVICE="x6885"
CONFIG_HAKIOS_UFS=y
CONFIG_BUTTONS=3
CONFIG_FBSCALE=3
CONFIG_FBFIT=3
CONFIG_FB_QUEUE=1
CONFIG_FB_FLIP=y
CONFIG_FB_INUSE=y
CONFIG_SURF_ALIGN=y
CONFIG_SURF_LOCKWAIT=y
